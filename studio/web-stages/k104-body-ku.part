#wm{position:absolute;left:50%;top:880px;width:820px;height:820px;margin:-410px 0 0 -410px;opacity:.14;border-radius:50%;filter:grayscale(.2)}
#scenes{position:absolute;left:0;right:0;top:300px;height:1920px}
#lg{display:none}
#nb{position:absolute;left:0;right:0;top:56px;text-align:center;z-index:20;direction:ltr}
#nb img{width:150px;height:150px;border-radius:50%;box-shadow:0 14px 40px rgba(0,0,0,.45)}
#nb .t{font:900 60px/1 I;letter-spacing:2px;margin-top:14px;color:#fff}
#nb .t span{font:700 30px I;letter-spacing:9px;color:rgba(255,255,255,.75);margin-left:10px}
#nb .h{font:700 36px I;color:rgba(255,255,255,.85);margin-top:8px}
body.tt #wm,body.tt #nb{display:none}
.btn{position:absolute;left:50%;transform:translateX(-50%);padding:30px 70px;border-radius:24px;background:#111;color:#fff;font:900 64px I;direction:ltr;white-space:nowrap;box-shadow:0 30px 60px rgba(0,0,0,.5),0 0 0 3px rgba(255,255,255,.25) inset}
.ckout{position:absolute;left:150px;right:150px;padding:40px 44px;border-radius:40px;background:#f5f6f8;color:#1b2a44;direction:ltr;box-shadow:0 50px 100px rgba(0,0,0,.55);font-family:I}
.ckout small{display:block;font:700 28px I;letter-spacing:3px;opacity:.55}
.ckout .pr{font:900 90px I;margin:6px 0 24px}
.ckout .bt{padding:24px;border-radius:20px;background:#111;color:#fff;text-align:center;font:900 46px I}
.stamp{position:absolute;left:50%;padding:20px 50px;border:10px solid #e3262f;border-radius:24px;color:#e3262f;font:900 110px I;direction:ltr;background:rgba(255,255,255,.92);box-shadow:0 0 40px rgba(230,40,50,.6);z-index:12}
.chain{position:absolute;left:60px;right:60px;display:flex;justify-content:center;align-items:center;gap:18px;direction:ltr}
.chain .mini{font:900 50px I;margin:0}
.chain .ar{font:900 60px I;color:var(--gold)}
.mini.red{background:linear-gradient(160deg,#ff6b74,#e3262f);border-color:transparent}
</style></head><body class="__CLS__"><div id="st">
