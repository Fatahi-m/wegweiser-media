 <div class="bub" style="top:520px" data-t="3.6" data-a="pop"><small>تۆ Rundfunkbeitrag دەدەیت یان Befreiung ت هەیە؟</small><b style="font:900 80px V">لە کۆمێنت بنووسە 👇</b></div>
 <div class="logo" style="top:1180px" id="lg"><img src="logo-ku.png" style="width:170px;height:170px"><div class="wm" style="font-size:56px;margin:14px 0 0">WEG<span style="color:#fff">WEISER</span> <span style="font:700 30px I;letter-spacing:8px;color:rgba(255,255,255,.7)">KURDI</span></div><div style="font:700 36px I;color:rgba(255,255,255,.8);margin-top:8px">@wegweiser_kurdi</div></div>
</div>
</div><div id="nb"><img src="logo-ku.png"><div class="t">WEGWEISER<span>KURDI</span></div><div class="h">@wegweiser_kurdi</div></div><div id="vig"></div><div class="flash" id="flash"></div></div>
<script>
const $=(q,e=document)=>e.querySelector(q);
const cl=x=>x<0?0:x>1?1:x; const eo=x=>{x=cl(x);return 1-Math.pow(1-x,3)}; const eio=x=>{x=cl(x);return x<.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2};
const back=x=>{x=cl(x);const c1=1.70158,c3=c1+1;return 1+c3*Math.pow(x-1,3)+c1*Math.pow(x-1,2)};
let seed=7; const rnd=()=>{seed=(seed*16807)%2147483647; return seed/2147483647;}; const ST=[];
for(let i=0;i<70;i++){ const e=document.createElement('i'); e.style.left=rnd()*1080+'px'; e.style.top=rnd()*1500+'px'; $('#stars').appendChild(e); ST.push({e,s:0.4+rnd()*1.1,ph:rnd()*6.28,sp:0.6+rnd()*1.6}); }
const TT=document.body.classList.contains('tt');
if(TT) document.querySelectorAll('.nott').forEach(e=>e.remove());
window.SC=__SC__; const N=SC.length;
function words(root,t,start,step){ root.querySelectorAll('.w').forEach((w,k)=>{ const q=eo((t-start-k*step)/0.45); w.style.opacity=q; w.style.transform=`translateY(${(1-q)*40}px)`; w.style.filter=`blur(${(1-q)*14}px)`; }); }
window.render=function(T0){
  $('#rays').style.transform=`rotate(${T0*2.2}deg)`; $('#floor').style.backgroundPosition=`0 ${(T0*40)%110}px`;
  $('#wm').style.transform=`rotate(${Math.sin(T0*0.3)*4}deg) scale(${1+Math.sin(T0*0.25)*0.02})`;
  ST.forEach(s=>{ s.e.style.opacity=0.35+0.65*(0.5+0.5*Math.sin(T0*s.sp+s.ph)); s.e.style.transform=`translateY(${-(T0*6*s.s)%40}px) scale(${s.s})`; });
  let fl=0;
  for(let i=0;i<N;i++){ const s=$('#s'+(i+1)); const [a,b]=SC[i]; const t=T0-a;
    if(T0<a-0.001||(T0>b+0.35&&i<N-1)){ s.style.opacity=0; continue; }
    const fin=i===0?1:eo(t/0.4), fout=i===N-1?1:1-eio((T0-(b-0.05))/0.4);
    s.style.opacity=Math.min(fin,fout); s.style.transform=`scale(${1+(1-fout)*0.08-(i===0?0:(1-fin)*0.06)})`; s.style.filter=fout<1?`blur(${(1-fout)*10}px)`:'none';
    if(i>0&&t<0.3) fl=Math.max(fl,(1-t/0.3)*0.18);
    const hl=s.querySelector('.hl'); if(hl) words(hl,t,i===0?-0.5:0.05,0.1);
    const n=s.querySelector('.num'); if(n){ const q=back((t-0.05)/0.5); n.style.opacity=cl(t/0.25); n.style.transform=`scale(${0.6+0.4*q})`; }
    s.querySelectorAll('[data-t]').forEach(e=>{ const q=(t-parseFloat(e.dataset.t))/0.5; const m=e.dataset.a;
      if(i===0&&parseFloat(e.dataset.t)<0.6&&m==='pop'){ e.style.opacity=1; e.style.transform='scale(1)'; return; }
      if(m==='pop'){ e.style.opacity=cl(q*1.5); e.style.transform=`scale(${0.6+0.4*back(q)})`; if(q>0&&q<0.6) fl=Math.max(fl,0.12*(1-q/0.6)); }
      else if(m==='pillx'){ e.style.opacity=cl(q*1.5); e.style.transform=`translateX(-50%) scale(${0.6+0.4*back(q)})`; }
      else if(m==='rise'){ const k=eo(q); e.style.opacity=k; e.style.transform=`translateX(${(1-k)*-90}px)`; }
    });
    if(i===N-1){ $('#lg').style.opacity=TT?0:eo((t-1.5)/0.6); }
  }
  $('#flash').style.opacity=fl;
};
render(0);
</script></body></html>
